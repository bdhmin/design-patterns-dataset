    {
      "id": "s9juw7ugccmwm",
      "title": "Why is the left ventricle thicker?",
      "createdAt": 1789652229000,
      "updatedAt": 1789652350213,
      "messages": [
        {
          "role": "user",
          "content": "why is the left ventricle wall thicker than the right",
          "ts": 1789652251204
        },
        {
          "role": "assistant",
          "content": "Because it pumps into the **systemic** circulation — the whole body — against a much higher pressure (≈120 mmHg systolic) than the right ventricle faces in the pulmonary circuit (≈25 mmHg). By Laplace's law more pressure needs more wall tension, so the muscle hypertrophies to cope. Same stroke volume, ~5× the pressure.",
          "ts": 1789652350213
        }
      ]
    }
  ],
