      "concept": {
        "label": "Derivative as a limit",
        "type": "formula",
        "anchor": "derivative f'(x) is defined as the limit of the difference quotient",
        "context": "f'(x) = lim h->0 [f(x+h) - f(x)]/h, slope of the tangent line."
      },
      "spec": {
        "type": "formula",
        "title": "Derivative as a limit",
        "caption": "f'(x) = lim h->0 [f(x+h) - f(x)]/h, slope of the tangent line.",
        "main_latex": "f'(x) = \\lim_{h \\to 0} \\frac{f(x+h) - f(x)}{h}",
        "steps": [
          {
            "latex": "\\frac{f(x+h)-f(x)}{h}",
            "explanation": "Slope of the secant line through x and x+h."
          },
          {
            "latex": "h \\to 0",
            "explanation": "Shrink the gap: the secant rotates into the tangent."
          },
          {
            "latex": "\\frac{(x+h)^2 - x^2}{h} = 2x + h",
            "explanation": "Example with f(x) = x^2."
          },
          {
            "latex": "f'(x) = 2x",
            "explanation": "Let h vanish."
          }
        ]
      },
      "attempts": 1
    },
