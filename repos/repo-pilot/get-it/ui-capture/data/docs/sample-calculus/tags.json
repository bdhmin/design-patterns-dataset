      "ready": true,
      "generating": false,
      "concept": {
        "label": "Fundamental Theorem",
        "type": "formula",
        "anchor": "of f and the x-axis over [a, b]. The Fundamental Theorem of Calculus",
        "context": "FTC parts I and II linking derivative and integral."
      },
      "spec": {
        "type": "formula",
        "title": "Fundamental Theorem",
        "caption": "FTC parts I and II linking derivative and integral.",
        "main_latex": "\\int_a^b f(x)\\,dx = F(b) - F(a)",
        "steps": [
          {
            "latex": "F(x) = \\int_a^x f(t)\\,dt",
            "explanation": "Accumulated area as a function of the upper limit."
          },
          {
            "latex": "F'(x) = f(x)",
            "explanation": "Part I: the rate the area grows equals the height of f."
          },
          {
            "latex": "\\int_a^b f = F(b) - F(a)",
            "explanation": "Part II: any antiderivative evaluates the integral."
          }
        ]
      },
      "attempts": 1
    },
